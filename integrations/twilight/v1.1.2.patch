+    ':favorite-button-liked="favoriteButtonLiked"',
+    ':favorite-button-loading="favoriteButtonLoading"',
+    ':favorite-button-title="favoriteButtonTitle"',
+    ':toggle-favorite="toggleFavorite"'
+  ]) {
+    assert.ok(app.includes(binding), `App must pass ${binding} to PlayerBar`)
