+test('set-favorite waits for authoritative state and is idempotent by request id', async (t) => {
+  const userDataPath = await mkdtemp(join(tmpdir(), 'twilight-taskbar-favorite-'))
+  t.after(() => rm(userDataPath, { recursive: true, force: true }))
+  let state = {
+    ...EMPTY_MINI_PLAYER_STATE,
+    track: {
+      id: 'ncm:42',
+      providerId: 'ncm',
+      title: 'Nightfall',
+      artist: 'Twilight Echo',
+      album: 'Bridge',
+      cover: null,
+      format: null,
+      sampleRate: null,
+      bitDepth: null,
+      coverSource: null
+    },
+    favoriteAvailable: true,
+    favoriteLiked: false,
+    favoriteLoading: false
+  }
+  let toggleCount = 0
+  const bridge = await startTaskbarBridge({
+    userDataPath,
+    getState: () => state,
+    dispatchCommand: (command) => {
+      assert.deepEqual(command, {
+        type: 'set-favorite',
+        liked: true,
+        expectedTrackId: 'ncm:42',
+        requestId: 'like-1'
+      })
+      toggleCount += 1
+      state = { ...state, favoriteLoading: true }
+      setTimeout(() => {
+        state = { ...state, favoriteLiked: true, favoriteLoading: false }
+      }, 15)
+      return true
+    },
+    favoritePollIntervalMs: 5,
+    favoriteTimeoutMs: 100
+  })
+  t.after(() => bridge.close())
+  const commandUrl = `http://127.0.0.1:${bridge.port}/taskbar/v1/command`
+  const sendFavorite = (requestId: string) =>
+    fetch(commandUrl, {
+      method: 'POST',
+      headers: {
+        authorization: `Bearer ${bridge.token}`,
+        'content-type': 'application/json'
+      },
+      body: JSON.stringify({
+        type: 'set-favorite',
+        liked: true,
+        expectedTrackId: 'ncm:42',
+        requestId
+      })
+    })
+
+  const [confirmed, repeated] = await Promise.all([sendFavorite('like-1'), sendFavorite('like-1')])
