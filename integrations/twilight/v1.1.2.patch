+
+  for (const prop of [
+    'favoriteButtonVisible?: boolean',
+    'favoriteButtonLiked?: boolean',
+    'favoriteButtonLoading?: boolean',
+    'favoriteButtonTitle?: string',
+    'toggleFavorite?: () => Promise<void>'
+  ]) {
+    assert.ok(playerBar.includes(prop), `PlayerBar must accept ${prop}`)
+  }
+})
