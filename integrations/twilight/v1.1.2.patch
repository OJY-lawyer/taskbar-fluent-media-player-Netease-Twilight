+import assert from 'node:assert/strict'
+import { mkdtemp, readFile, rm, stat } from 'node:fs/promises'
+import { tmpdir } from 'node:os'
+import { join } from 'node:path'
+import test from 'node:test'
+import { EMPTY_MINI_PLAYER_STATE } from '../../shared/miniPlayer.ts'
+import { startTaskbarBridge } from './taskbarBridge.ts'
+
+test('taskbar bridge writes discovery and protects health with local bearer access', async (t) => {
+  const userDataPath = await mkdtemp(join(tmpdir(), 'twilight-taskbar-bridge-'))
+  t.after(() => rm(userDataPath, { recursive: true, force: true }))
+
+  const bridge = await startTaskbarBridge({
+    userDataPath,
+    getState: () => null,
+    dispatchCommand: () => false
+  })
+  t.after(() => bridge.close())
+
+  const discoveryPath = join(userDataPath, 'taskbar-bridge.json')
+  const discovery = JSON.parse(await readFile(discoveryPath, 'utf8'))
+  assert.equal(discovery.bridgeVersion, 1)
+  assert.equal(discovery.host, '127.0.0.1')
+  assert.equal(discovery.port, bridge.port)
+  assert.equal(discovery.baseUrl, `http://127.0.0.1:${bridge.port}/taskbar/v1`)
+  assert.equal(discovery.token, bridge.token)
+  assert.equal(discovery.instanceId, bridge.instanceId)
+  assert.ok(discovery.port > 0)
+  assert.ok(discovery.token.length >= 32)
+  assert.ok(discovery.instanceId.length >= 32)
+
+  const healthUrl = `http://127.0.0.1:${bridge.port}/taskbar/v1/health`
+  assert.equal((await fetch(healthUrl)).status, 401)
+  assert.equal(
+    (
+      await fetch(healthUrl, {
+        headers: {
+          authorization: `Bearer ${bridge.token}`,
+          origin: 'http://127.0.0.1'
+        }
+      })
+    ).status,
+    403
+  )
+
+  const response = await fetch(healthUrl, {
+    headers: { authorization: `Bearer ${bridge.token}` }
+  })
+  assert.equal(response.status, 200)
+  assert.deepEqual(await response.json(), {
+    bridgeVersion: 1,
+    instanceId: bridge.instanceId,
+    status: 'ok'
+  })
+
+  await bridge.close()
+  await assert.rejects(stat(discoveryPath), { code: 'ENOENT' })
+})
+
