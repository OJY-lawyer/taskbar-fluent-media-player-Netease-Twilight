+import { randomBytes, randomUUID } from 'node:crypto'
+import { createServer, type IncomingMessage, type Server, type ServerResponse } from 'node:http'
+import type { AddressInfo } from 'node:net'
+import { join } from 'node:path'
+import {
+  clearJsonFileArtifacts,
+  writeJsonFileAtomic,
+  type JsonFileOptions
+} from '../persistence/jsonFile.ts'
+import {
+  EMPTY_MINI_PLAYER_STATE,
+  normalizeMiniPlayerCommand,
+  type MiniPlayerCommand,
+  type MiniPlayerStateSnapshot
+} from '../../shared/miniPlayer.ts'
+
+const TASKBAR_BRIDGE_HOST = '127.0.0.1'
+const TASKBAR_BRIDGE_VERSION = 1
+const TASKBAR_BRIDGE_FILE = 'taskbar-bridge.json'
+
+interface TaskbarBridgeDiscovery {
+  bridgeVersion: 1
+  host: typeof TASKBAR_BRIDGE_HOST
+  port: number
+  baseUrl: string
+  token: string
+  instanceId: string
+  pid: number
+}
+
+const TASKBAR_BRIDGE_DISCOVERY_OPTIONS: JsonFileOptions<TaskbarBridgeDiscovery> = {
+  label: 'taskbar bridge discovery',
+  maxBytes: 4096,
+  validate: (value): value is TaskbarBridgeDiscovery => {
+    if (!value || typeof value !== 'object' || Array.isArray(value)) return false
+    const record = value as Record<string, unknown>
+    return (
+      record.bridgeVersion === TASKBAR_BRIDGE_VERSION &&
+      record.host === TASKBAR_BRIDGE_HOST &&
+      typeof record.port === 'number' &&
+      Number.isInteger(record.port) &&
+      record.port > 0 &&
+      typeof record.baseUrl === 'string' &&
+      record.baseUrl === `http://${TASKBAR_BRIDGE_HOST}:${record.port as number}/taskbar/v1` &&
+      typeof record.token === 'string' &&
+      record.token.length >= 32 &&
+      typeof record.instanceId === 'string' &&
+      record.instanceId.length >= 32 &&
+      typeof record.pid === 'number' &&
+      Number.isInteger(record.pid) &&
+      record.pid > 0
+    )
+  }
+}
+
+export interface TaskbarBridgeDependencies {
+  userDataPath: string
+  getState: () => MiniPlayerStateSnapshot | null
+  dispatchCommand: (command: MiniPlayerCommand) => boolean
+  nowMs?: () => number
+  favoritePollIntervalMs?: number
+  favoriteTimeoutMs?: number
+}
+
+export interface TaskbarBridgeHandle {
+  port: number
+  token: string
+  instanceId: string
+  discoveryPath: string
+  close: () => Promise<void>
+}
+
+interface TaskbarPlaybackClock {
+  trackId: string | null
+  sourceTime: number
+  observedAtMs: number
+  wasAdvancing: boolean
+}
+
+function advancePlaybackTime(
+  state: MiniPlayerStateSnapshot,
+  clock: TaskbarPlaybackClock,
+  nowMs: number
+): number {
+  const trackId = state.track?.id ?? null
+  const sourceTime = Number.isFinite(state.currentTime) ? Math.max(0, state.currentTime) : 0
+  const advancing = state.isPlaying && !state.isLoading && trackId !== null
+  if (
+    clock.trackId !== trackId ||
+    clock.sourceTime !== sourceTime ||
+    clock.wasAdvancing !== advancing
+  ) {
+    clock.trackId = trackId
+    clock.sourceTime = sourceTime
+    clock.observedAtMs = nowMs
+    clock.wasAdvancing = advancing
+  }
+  const elapsed = advancing ? Math.max(0, nowMs - clock.observedAtMs) / 1000 : 0
+  const advanced = sourceTime + elapsed
+  return state.duration > 0 ? Math.min(state.duration, advanced) : advanced
+}
+
+function lyricAtTime(
+  state: MiniPlayerStateSnapshot,
+  currentTime: number
+): MiniPlayerStateSnapshot['currentLyric'] {
+  let active = -1
+  for (let i = 0; i < state.lyrics.length; i += 1) {
+    const time = state.lyrics[i].time
+    if (time == null || time > currentTime) break
+    active = i
+  }
+  if (active < 0) return state.currentLyric
+  const line = state.lyrics[active]
+  return { original: line.original, translation: line.translation }
+}
+
+function selectTaskbarState(
+  state: MiniPlayerStateSnapshot | null,
+  clock: TaskbarPlaybackClock,
+  nowMs: number
+) {
+  const source = state ?? EMPTY_MINI_PLAYER_STATE
+  const currentTime = advancePlaybackTime(source, clock, nowMs)
+  const favoriteAllowed = source.track?.providerId === 'ncm'
+  return {
+    track: source.track
+      ? {
+          id: source.track.id,
+          providerId: source.track.providerId,
+          title: source.track.title,
+          artist: source.track.artist,
+          album: source.track.album,
+          cover: source.track.cover,
+          coverSource: source.track.coverSource
+        }
+      : null,
+    currentLyric: lyricAtTime(source, currentTime),
+    isPlaying: source.isPlaying,
+    isLoading: source.isLoading,
+    currentTime,
+    duration: source.duration,
+    favoriteAvailable: favoriteAllowed && source.favoriteAvailable,
+    favoriteLiked: favoriteAllowed && source.favoriteLiked,
+    favoriteLoading: favoriteAllowed && source.favoriteLoading
+  }
+}
+
+function writeJson(response: ServerResponse, status: number, value: unknown): void {
+  response.writeHead(status, {
+    'content-type': 'application/json; charset=utf-8',
+    'cache-control': 'no-store'
+  })
+  response.end(JSON.stringify(value))
+}
+
+function authorizeRequest(
+  request: IncomingMessage,
+  response: ServerResponse,
+  token: string
+): boolean {
+  if (request.headers.origin !== undefined) {
+    writeJson(response, 403, { error: 'origin_not_allowed' })
+    return false
+  }
+  if (request.headers.authorization !== `Bearer ${token}`) {
+    response.setHeader('www-authenticate', 'Bearer')
+    writeJson(response, 401, { error: 'unauthorized' })
+    return false
+  }
+  return true
+}
+
+function readRequestBody(request: IncomingMessage): Promise<string> {
+  return new Promise((resolve, reject) => {
+    let body = ''
+    request.setEncoding('utf8')
+    request.on('data', (chunk: string) => {
+      body += chunk
+      if (body.length > 16 * 1024) reject(new Error('request_too_large'))
+    })
+    request.on('end', () => resolve(body))
+    request.on('error', reject)
+  })
+}
+
+type SetFavoriteCommand = Extract<MiniPlayerCommand, { type: 'set-favorite' }>
+
+interface CommandResponse {
+  statusCode: number
+  body: Record<string, unknown>
+}
+
+function wait(delayMs: number): Promise<void> {
+  return new Promise((resolve) => setTimeout(resolve, delayMs))
+}
+
+function favoriteResult(
+  command: SetFavoriteCommand,
+  status: 'confirmed' | 'noop' | 'pending',
+  confirmed: boolean
+): CommandResponse {
+  return {
+    statusCode: status === 'pending' ? 202 : 200,
+    body: {
+      ok: true,
+      status,
+      confirmed,
+      requestId: command.requestId,
+      trackId: command.expectedTrackId,
+      liked: command.liked
+    }
+  }
+}
+
+function createCommandRequestHandler(dependencies: TaskbarBridgeDependencies) {
+  const favoriteRequests = new Map<
+    string,
+    { signature: string; result: Promise<CommandResponse> }
+  >()
+  let favoriteCommandInFlight = false
+  const pollIntervalMs = Math.max(1, dependencies.favoritePollIntervalMs ?? 75)
+  const maxPolls = Math.max(1, Math.ceil((dependencies.favoriteTimeoutMs ?? 4500) / pollIntervalMs))
+
+  async function executeFavorite(command: SetFavoriteCommand): Promise<CommandResponse> {
+    const initial = dependencies.getState()
+    if (!initial?.track || initial.track.id !== command.expectedTrackId) {
+      return {
+        statusCode: 409,
+        body: { error: 'track_changed', requestId: command.requestId }
+      }
+    }
+    if (initial.track.providerId !== 'ncm' || !initial.favoriteAvailable) {
+      return {
+        statusCode: 503,
+        body: { error: 'favorite_unavailable', requestId: command.requestId }
+      }
+    }
+    if (initial.favoriteLoading || favoriteCommandInFlight) {
+      return {
+        statusCode: 409,
+        body: { error: 'favorite_busy', requestId: command.requestId }
+      }
+    }
+    if (initial.favoriteLiked === command.liked) {
+      return favoriteResult(command, 'noop', true)
+    }
+
+    favoriteCommandInFlight = true
+    try {
+      if (!dependencies.dispatchCommand(command)) {
+        return {
+          statusCode: 503,
+          body: { error: 'player_unavailable', requestId: command.requestId }
+        }
+      }
+
+      let sawLoading = false
+      for (let attempt = 0; attempt < maxPolls; attempt += 1) {
+        await wait(pollIntervalMs)
+        const current = dependencies.getState()
+        if (
+          !current?.track ||
+          current.track.id !== command.expectedTrackId ||
+          current.track.providerId !== 'ncm'
+        ) {
+          return {
+            statusCode: 409,
+            body: { error: 'track_changed', requestId: command.requestId }
+          }
+        }
+        if (current.favoriteLoading) {
+          sawLoading = true
+          continue
+        }
+        if (current.favoriteLiked === command.liked) {
+          return favoriteResult(command, 'confirmed', true)
+        }
+        if (sawLoading) {
+          return {
+            statusCode: 409,
+            body: {
+              error: 'favorite_not_applied',
+              requestId: command.requestId,
+              trackId: command.expectedTrackId,
+              liked: current.favoriteLiked
+            }
+          }
+        }
+      }
+      return favoriteResult(command, 'pending', false)
+    } finally {
+      favoriteCommandInFlight = false
+    }
+  }
+
+  function rememberFavoriteRequest(command: SetFavoriteCommand): Promise<CommandResponse> {
+    const signature = JSON.stringify(command)
+    const existing = favoriteRequests.get(command.requestId)
+    if (existing) {
+      return existing.signature === signature
+        ? existing.result
+        : Promise.resolve({
+            statusCode: 409,
+            body: { error: 'request_id_conflict', requestId: command.requestId }
+          })
+    }
+    const result = executeFavorite(command)
+    favoriteRequests.set(command.requestId, { signature, result })
+    if (favoriteRequests.size > 128) {
+      favoriteRequests.delete(favoriteRequests.keys().next().value as string)
+    }
+    return result
+  }
+
+  return async (request: IncomingMessage, response: ServerResponse): Promise<void> => {
+    try {
+      const raw = JSON.parse(await readRequestBody(request))
+      const command = normalizeMiniPlayerCommand(raw)
+      if (
+        command?.type === 'toggle-play' ||
+        command?.type === 'previous' ||
+        command?.type === 'next'
+      ) {
+        if (!dependencies.dispatchCommand(command)) {
+          writeJson(response, 503, { error: 'player_unavailable' })
+          return
+        }
+        writeJson(response, 200, { ok: true, status: 'accepted' })
+        return
+      }
+
+      if (command?.type !== 'set-favorite') {
+        writeJson(response, 400, { error: 'invalid_command' })
+        return
+      }
+      const result = await rememberFavoriteRequest(command)
+      writeJson(response, result.statusCode, result.body)
+    } catch (error) {
+      const tooLarge = error instanceof Error && error.message === 'request_too_large'
+      writeJson(response, tooLarge ? 413 : 400, {
+        error: tooLarge ? 'request_too_large' : 'invalid_json'
+      })
+    }
+  }
+}
+
+function createTaskbarBridgeServer(
+  dependencies: TaskbarBridgeDependencies,
+  token: string,
+  instanceId: string
+): Server {
+  const clock: TaskbarPlaybackClock = {
+    trackId: null,
+    sourceTime: 0,
+    observedAtMs: 0,
+    wasAdvancing: false
+  }
+  const nowMs = dependencies.nowMs ?? Date.now
+  const handleCommandRequest = createCommandRequestHandler(dependencies)
+  let revision = 0
+  let lastStateSignature = ''
+  return createServer((request, response) => {
+    if (!authorizeRequest(request, response, token)) return
+    const path = request.url?.split('?', 1)[0] ?? '/'
+    if (request.method === 'GET' && path === '/taskbar/v1/health') {
+      writeJson(response, 200, {
+        bridgeVersion: TASKBAR_BRIDGE_VERSION,
+        instanceId,
+        status: 'ok'
+      })
+      return
+    }
+    if (request.method === 'GET' && path === '/taskbar/v1/state') {
+      const projected = selectTaskbarState(dependencies.getState(), clock, nowMs())
+      const signature = JSON.stringify(projected)
+      if (signature !== lastStateSignature) {
+        lastStateSignature = signature
+        revision += 1
+      }
+      writeJson(response, 200, {
+        bridgeVersion: TASKBAR_BRIDGE_VERSION,
+        instanceId,
+        revision,
+        ...projected
+      })
+      return
+    }
+    if (request.method === 'POST' && path === '/taskbar/v1/command') {
+      void handleCommandRequest(request, response)
+      return
+    }
+
+    writeJson(response, 404, { error: 'not_found' })
+  })
+}
+
+function listen(server: Server): Promise<number> {
+  return new Promise((resolve, reject) => {
+    const onError = (error: Error): void => reject(error)
+    server.once('error', onError)
+    server.listen(0, TASKBAR_BRIDGE_HOST, () => {
+      server.off('error', onError)
+      resolve((server.address() as AddressInfo).port)
+    })
+  })
+}
+
+function closeServer(server: Server): Promise<void> {
+  if (!server.listening) return Promise.resolve()
+  return new Promise((resolve, reject) => {
+    server.close((error) => (error ? reject(error) : resolve()))
+  })
+}
+
+export async function startTaskbarBridge(
+  dependencies: TaskbarBridgeDependencies
+): Promise<TaskbarBridgeHandle> {
+  const token = randomBytes(32).toString('hex')
+  const instanceId = randomUUID()
+  const server = createTaskbarBridgeServer(dependencies, token, instanceId)
+  const port = await listen(server)
+  const discoveryPath = join(dependencies.userDataPath, TASKBAR_BRIDGE_FILE)
+  const baseUrl = `http://${TASKBAR_BRIDGE_HOST}:${port}/taskbar/v1`
+  const discovery: TaskbarBridgeDiscovery = {
+    bridgeVersion: TASKBAR_BRIDGE_VERSION,
+    host: TASKBAR_BRIDGE_HOST,
+    port,
+    baseUrl,
+    token,
+    instanceId,
+    pid: process.pid
+  }
+
+  try {
+    writeJsonFileAtomic(
+      discoveryPath,
+      JSON.stringify(discovery),
+      TASKBAR_BRIDGE_DISCOVERY_OPTIONS,
+      discovery
+    )
+  } catch (error) {
+    await closeServer(server)
+    throw error
+  }
+
+  server.unref()
+  let closePromise: Promise<void> | null = null
+  return {
+    port,
+    token,
+    instanceId,
+    discoveryPath,
+    close: () => {
+      if (closePromise) return closePromise
+      clearJsonFileArtifacts(discoveryPath)
+      closePromise = closeServer(server)
+      return closePromise
+    }
+  }
+}
